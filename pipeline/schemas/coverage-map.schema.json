{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Process coverage map",
  "description": "episodes/inside-the-process/<EPID>/story/coverage-map.json — what a complete explanation of this episode's process must answer. Created and owner-approved at 01b-coverage-scan; 02a fills claim_ids, 03a fills script_rows. Contract: pipeline/process_coverage.md. Checked by tools/coverage_validator.py.",
  "type": "object",
  "required": ["schema_version", "episode_id", "topic", "archetype", "process_chain", "scope", "items", "benchmark_topics", "naive_viewer_questions"],
  "properties": {
    "schema_version": { "const": 1 },
    "episode_id": { "type": "string", "pattern": "^EP[0-9]{3}" },
    "topic": { "type": "string", "minLength": 1 },
    "archetype": { "enum": ["manufactured_product", "biological_process", "natural_phenomenon", "system_infrastructure", "other"] },
    "custom_dimensions": {
      "type": "array",
      "description": "Only for archetype 'other': at least four dimensions, each needing a MUST item.",
      "items": {
        "type": "object",
        "required": ["id", "question"],
        "properties": { "id": { "type": "string", "pattern": "^[a-z_]+$" }, "question": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "process_chain": {
      "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 },
      "description": "Every state from the TRUE raw/original starting substance to the finished result in use — written before scope is chosen, so a narrowed scope is a visible decision."
    },
    "scope": {
      "type": "object",
      "required": ["starts_at", "ends_at"],
      "properties": { "starts_at": { "type": "string", "minLength": 1 }, "ends_at": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "dimension", "priority", "scope", "question"],
        "properties": {
          "id": { "type": "string", "pattern": "^COV[0-9]{2,3}$" },
          "dimension": { "type": "string" },
          "priority": { "enum": ["MUST", "OPTIONAL"] },
          "scope": { "enum": ["in", "out"] },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "description": "Why an out-of-scope item is out of scope." },
          "disclosure": { "type": "string", "description": "The exact words the episode says on screen about the deliberate gap; must appear verbatim in story/script.md." },
          "claim_ids": { "type": "array", "items": { "type": "string", "pattern": "^CLM-[0-9]+$" } },
          "script_rows": { "type": "array", "items": { "type": "string" }, "description": "'#' values of the story/script.md beat-table rows that explain this item." },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "benchmark_topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "seen_in"],
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "seen_in": { "type": "array", "minItems": 1, "items": { "enum": ["B01", "B02", "B03"] } },
          "item": { "type": "string", "pattern": "^COV[0-9]{2,3}$" },
          "not_used_reason": { "type": "string", "description": "Only for a topic seen in ONE benchmark that the episode does not need (e.g. a marketing aside)." }
        },
        "additionalProperties": false
      }
    },
    "naive_viewer_questions": {
      "type": "array", "minItems": 5,
      "items": {
        "type": "object",
        "required": ["question", "item"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "item": { "type": "string", "pattern": "^COV[0-9]{2,3}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
